  <!-- Generic "combo" driver: placeable in a room, runs Lua, no Navigator UI
       (our UI is the ESP32). This is the official SDK pattern from the
       generic_http / generic_tcp samples — combo + a generic proxy, no
       <connections>. Our prior `control4_generic` string was invalid. -->
  <!-- TWO proxies: the keypad proxy (5002) exposing N programmable on-screen buttons
       with RGB LEDs, and the intercom endpoint (5003). Composer renders this as a real
       parent/child tree: the PRIMARY proxy is the parent device, the other a sub-proxy.

       A proxy's element text must be the EXACT basename of a manifest in the
       Director's /opt/control4/var/drivers/c4i/ — Director resolves `foo` to
       `foo.c4i` and SILENTLY SKIPS a name it can't resolve, instantiating no child
       and reporting nothing useful. Verified on a live EA3 (2026-07-19): the proxy is
       `keypad_proxy`, NOT `keypad`, and there is no `generic_http` proxy at all — both
       of those names were inherited from the old driver, where <combo> meant no proxy
       was ever instantiated so the mistake stayed invisible. `generic_http` is dropped
       rather than renamed: it existed only as a "placeable shell", a job the DEVICE
       parent already does now that <combo> is gone, and driver.lua never used 5001. -->
  <!-- Check any name before adding one:
       ssh root@<director> 'ls /opt/control4/var/drivers/c4i/ | grep <name>' -->
  <!-- NO <combo>true</combo>. Verified empirically on a live EA3 Director
       (2026-07-19): a driver declaring <combo> is registered as a single
       PROXY-typed project item and Director instantiates NONE of its declared
       proxies — no <proxy>.c4i child items, so ReceivedFromProxy never fires and
       the keypad/intercom proxies are inert. Removing it produced the correct
       DEVICE parent + proxy children. Every working multi-proxy driver on that
       Director agrees: control4_doorstation_ds2 and chowmain_unifi_access_
       intercom_v2 both declare multiple proxies and neither declares <combo>. -->
  <!-- The device IS a keypad, so the keypad proxy is PRIMARY (it presents as a keypad in
       Composer). generic_http stays as a secondary comms/placeable shell that owns the
       network binding. The now-playing display reads room variables directly, independent
       of which proxy is primary.

       intercomproxy is a NON-primary sub-proxy here. The rule is that a driver must have
       *a* primary — not that the intercom must be it; Control4's own
       control4_doorstation_ds2.c4z ships doorstation + camera + intercomproxy the same
       way. This replaces the old arrangement where a separate companion .c4z hosted the
       intercom and the two drivers talked over a private control binding: one driver, one
       device, one :6700 link, and ReceivedFromProxy dispatches on the binding id. -->
  <proxies>
    <proxy proxybindingid="5002" name="Media Keypad" primary="True">keypad_proxy</proxy>
  </proxies>

  <connections>
    <connection>
      <id>5002</id>
      <type>2</type>
      <connectionname>Keypad</connectionname>
      <consumer>False</consumer>
      <classes><class><classname>KEYPAD</classname></class></classes>
    </connection>
    <!-- Per-button BUTTON_LINK bindings (CONTROL type 1) so each button is linkable
         in Composer Connections, like a Control4 keypad. binding id 300+N -> button N. -->
    <connection proxybindingid="5002"><id>301</id><type>1</type><connectionname>Button 1</connectionname><consumer>True</consumer><classes><class><classname>BUTTON_LINK</classname></class></classes></connection>
    <connection proxybindingid="5002"><id>302</id><type>1</type><connectionname>Button 2</connectionname><consumer>True</consumer><classes><class><classname>BUTTON_LINK</classname></class></classes></connection>
    <connection proxybindingid="5002"><id>303</id><type>1</type><connectionname>Button 3</connectionname><consumer>True</consumer><classes><class><classname>BUTTON_LINK</classname></class></classes></connection>
    <connection proxybindingid="5002"><id>304</id><type>1</type><connectionname>Button 4</connectionname><consumer>True</consumer><classes><class><classname>BUTTON_LINK</classname></class></classes></connection>
    <connection proxybindingid="5002"><id>305</id><type>1</type><connectionname>Button 5</connectionname><consumer>True</consumer><classes><class><classname>BUTTON_LINK</classname></class></classes></connection>
    <connection proxybindingid="5002"><id>306</id><type>1</type><connectionname>Button 6</connectionname><consumer>True</consumer><classes><class><classname>BUTTON_LINK</classname></class></classes></connection>
    <!-- Intercom relay PROVIDER (control binding 700). The companion
         NuVoxelKeypadIntercom driver (intercomproxy-primary, so the Communication
         agent enrolls it) consumes this; we forward its SIP/call JSON onto the device
         :6700 link and relay device lines back. -->
    <connection>
      <id>700</id>
      <facing>6</facing>
      <connectionname>NuVoxel Keypad Intercom Relay</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <classes><class><classname>MMKEYPAD_INTERCOM</classname></class></classes>
    </connection>
    <!-- Network binding the installer associates with the SDDP-discovered MMKeypad
         on the Connections page. The DRIVER connects OUT to the device (which is a
         TCP server on this port). auto_connect=True so Director dials it on bind. -->
    <connection>
      <id>6001</id>
      <facing>1</facing>
      <connectionname>Media Keypad Network</connectionname>
      <type>4</type>
      <consumer>True</consumer>
      <classes>
        <class>
          <classname>TCP</classname>
          <ports>
            <port>
              <number>6700</number>
              <auto_connect>True</auto_connect>
              <monitor_connection>True</monitor_connection>
              <keep_connection>True</keep_connection>
              <keep_alive>True</keep_alive>
            </port>
          </ports>
        </class>
      </classes>
    </connection>
  </connections>

</devicedata>
