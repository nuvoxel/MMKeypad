  <minimum_os_version>2.10.0</minimum_os_version>

  <!-- Comms/UI categories so the driver lands in the right Add-Driver sections now
       that it hosts the intercom endpoint itself (mirrors the T4 touchscreen). -->
  <composer_categories>
    <category>Communications</category>
    <category>User Interface</category>
  </composer_categories>

  <!-- Intercom capabilities, for the intercomproxy sub-proxy (5003). Audio-only
       auto-answer station — speaker + mic + ringer, monitor mode, door chime; no
       camera/display/video.

       driver_arch_type = 5 (third-party endpoint). Verified on the live Director:
       arch_type=4 is the NATIVE archetype (control4_doorstation_ds2), while every
       third-party intercom uses 5 — INCLUDING our own old split drivers
       (MMKeypadIntercom / MediaKeypadIntercom), which worked. So arch_type is NOT
       what stops the merged sub-proxy endpoint from being enrolled by the
       Communications agent (both the working split and the broken merge use 5);
       the regression is elsewhere (prime suspect: intercomproxy went from PRIMARY
       in the standalone driver to a SUB-proxy here). Carried over from the retired
       companion intercom driver. -->
  <!-- ONE flat capabilities block serves ALL proxies — keys are claimed by whichever
       proxy understands them, not nested per-proxy. Verified against two shipping
       multi-proxy drivers on a live Director: control4_doorstation_ds2 (3 proxies) and
       chowmain_unifi_access_intercom_v2 (2 proxies) each declare exactly one block.

       KEYPAD half (below) — modelled on lutron_leap_keypad, the one third-party
       keypad_proxy driver on that Director. Without these the proxy has no reason to
       believe the keypad is editable and Composer greys out its native Button Settings
       panel, which is exactly what happened: we were sending NEW_KEYPAD_BUTTON for six
       buttons and the proxy ignored every one. The keypad keys do not collide with the
       intercom keys below (`has_buttons` belongs to the intercom/doorstation vocabulary
       and means custom call buttons — NOT keypad buttons — so it stays false). -->
  <capabilities>
    <has_button_events>True</has_button_events>
    <button_behavior>True</button_behavior>
    <click_support>True</click_support>
    <multi_click_support>True</multi_click_support>
    <fully_customizable>True</fully_customizable>
    <flow_top_down>True</flow_top_down>
    <has_leds>True</has_leds>
    <led_behavior>True</led_behavior>
    <leds_have_color>True</leds_have_color>
    <!-- On-screen labels, not physical engraving, and no faceplate finishes. -->
    <engravable>False</engravable>
    <custom_finishes>False</custom_finishes>
    <fallback_support>False</fallback_support>
    <hide_proxy_properties>False</hide_proxy_properties>
    <hide_proxy_commands>False</hide_proxy_commands>
    <hide_proxy_conditionals>False</hide_proxy_conditionals>
    <hide_proxy_events>False</hide_proxy_events>

    <driver_arch_type>5</driver_arch_type>
    <has_intercom>true</has_intercom>
    <has_video_intercom>false</has_video_intercom>
    <is_doorstation>false</is_doorstation>
    <has_camera>false</has_camera>
    <has_display>false</has_display>
    <has_buttons>false</has_buttons>
    <has_dial_pad_ui>false</has_dial_pad_ui>
    <has_play_door_chime>true</has_play_door_chime>
    <has_auto_answer>true</has_auto_answer>
    <has_do_not_disturb>true</has_do_not_disturb>
    <has_early_media>false</has_early_media>
    <has_monitor_mode>true</has_monitor_mode>
    <has_mcast_emedia>false</has_mcast_emedia>
    <can_change_transport>false</can_change_transport>
