# Vendored third-party source trees (busybox, dropbear) -- fetched by the
# build, not ours to commit.
thirdparty/

# Build artifacts (init binary, ramdisk, boot.img, LVGL demo).
build/
lvgl-app/build/

# Belt and braces on top of `build/` above. Two things living under build/ are
# NOT build output and must never reach a public repo, so they are named
# explicitly — if `build/` is ever narrowed, these stay ignored:
#   build/firmware/     Control4's extracted factory firmware. Proprietary, and
#                       not ours to redistribute. Supply it from your own unit.
#   build/backup-*/     Full per-unit dumps taken off a panel over USB loader or
#                       the network. They carry that unit's identity and are the
#                       only way back if a reflash goes wrong — irreplaceable,
#                       and specific to one piece of hardware.
build/firmware/
build/backup-*/

# Serial/console capture logs.
log/

# rootfs staging: everything here except the hand-written config is
# generated (busybox `make install` symlinks + binary, cross-built dropbear,
# the LVGL app) or proprietary (extracted Control4 kernel modules).
rootfs/init
rootfs/linuxrc
rootfs/bin/
rootfs/sbin/
rootfs/usr/bin/
rootfs/usr/sbin/
rootfs/lib/modules/
